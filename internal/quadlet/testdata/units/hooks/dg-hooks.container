# Generated by dermaga. Don't edit: change the app with dermaga instead.
[Quadlet]
DefaultDependencies=false

[Unit]
Description=dermaga hook relay (Traefik to hooks.sock)

[Container]
ContainerName=dg-hooks
Rootfs=/home/server/.local/share/dermaga/relay:O
Exec=/dermaga hook-relay -listen :8080 -target /run/dermaga/hooks.sock
Network=web.network
Volume=/run/user/1001/dermaga/hooks:/run/dermaga
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
PidsLimit=32
PodmanArgs=--memory=32m
StopTimeout=5

[Service]
Restart=always
TimeoutStopSec=25

[Install]
WantedBy=default.target
