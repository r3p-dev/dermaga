# Generated by dermaga. Don't edit: change the app with dermaga instead.
[Quadlet]
DefaultDependencies=false

[Unit]
Description=dermaga database mariadb (mariadb)

[Container]
ContainerName=dg-db-mariadb
Image=docker.io/library/mariadb:11.8
Pull=never
Network=dg-db-mariadb.network
EnvironmentFile=/home/server/.config/dermaga/env/db-mariadb.env
Label=dermaga.database=mariadb
Label=dermaga.engine=mariadb
NoNewPrivileges=true
DropCapability=ALL
AddCapability=CHOWN DAC_OVERRIDE SETGID SETUID KILL
PidsLimit=512
PodmanArgs=--memory=512m --cpus=1
StopTimeout=25
Volume=dg-db_mariadb.volume:/var/lib/mysql

[Service]
Restart=always
TimeoutStartSec=120
TimeoutStopSec=45

[Install]
WantedBy=default.target
