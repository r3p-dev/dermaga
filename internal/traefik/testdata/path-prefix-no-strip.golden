{
  "http": {
    "routers": {
      "app-docs-service": {
        "entryPoints": [
          "websecure"
        ],
        "rule": "Host(`example.com`) \u0026\u0026 PathPrefix(`/docs`)",
        "service": "app-docs-service",
        "middlewares": [
          "app-docs-service-headers"
        ],
        "tls": {
          "certResolver": "le"
        }
      }
    },
    "services": {
      "app-docs-service": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://app-docs-service-r1:4000"
            }
          ]
        }
      }
    },
    "middlewares": {
      "app-docs-service-headers": {
        "headers": {
          "stsSeconds": 31536000,
          "stsIncludeSubdomains": true,
          "contentTypeNosniff": true,
          "customFrameOptionsValue": "SAMEORIGIN",
          "referrerPolicy": "strict-origin-when-cross-origin",
          "customResponseHeaders": {
            "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
            "Server": "",
            "X-Powered-By": ""
          }
        }
      }
    }
  }
}