{
  "global": {
    "checkNewVersion": false,
    "sendAnonymousUsage": false
  },
  "log": {
    "level": "WARN",
    "format": "json"
  },
  "accessLog": {
    "format": "json",
    "bufferingSize": 64
  },
  "entryPoints": {
    "web": {
      "address": ":80",
      "http": {
        "redirections": {
          "entryPoint": {
            "to": "websecure",
            "scheme": "https",
            "permanent": true
          }
        },
        "aliasHeadersStrategy": "delete",
        "encodedCharacters": {
          "allowEncodedBackSlash": false,
          "allowEncodedNullCharacter": false
        }
      },
      "forwardedHeaders": {
        "trustedIPs": [
          "173.245.48.0/20",
          "103.21.244.0/22"
        ]
      }
    },
    "websecure": {
      "address": ":443",
      "http": {
        "tls": {
          "certResolver": "le"
        },
        "aliasHeadersStrategy": "delete",
        "encodedCharacters": {
          "allowEncodedBackSlash": false,
          "allowEncodedNullCharacter": false
        }
      },
      "http3": {},
      "forwardedHeaders": {
        "trustedIPs": [
          "173.245.48.0/20",
          "103.21.244.0/22"
        ]
      }
    }
  },
  "providers": {
    "file": {
      "directory": "/etc/traefik/dynamic",
      "watch": true
    }
  },
  "certificatesResolvers": {
    "le": {
      "acme": {
        "email": "admin@example.com",
        "storage": "/acme/acme.json",
        "httpChallenge": {
          "entryPoint": "web"
        }
      }
    }
  },
  "api": {
    "dashboard": false
  }
}