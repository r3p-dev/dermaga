[Unit]
Description=dermaga app worker release 3

[Container]
ContainerName=app-worker-r3
Image=localhost/worker:r3
Network=web
PidsLimit=128
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
ReadOnlyTmpfs=true
StopTimeout=10

[Quadlet]
DefaultDependencies=false

[Service]
Restart=on-failure
RestartSec=1s
RestartSteps=3
RestartMaxDelaySec=8s
TimeoutStartSec=30
TimeoutStopSec=20

[Install]
WantedBy=default.target
