[Unit]
Description=dermaga app backend release 4

[Container]
ContainerName=app-backend-r4
Image=localhost/backend:r4
Network=web
PidsLimit=128
NoNewPrivileges=true
DropCapability=ALL
EnvironmentFile=/home/server/.config/dermaga/env/backend.env
StopTimeout=10

[Quadlet]
DefaultDependencies=false

[Service]
Restart=on-failure
RestartSec=1s
RestartSteps=3
RestartMaxDelaySec=8s
TimeoutStartSec=30
TimeoutStopSec=20

[Install]
WantedBy=default.target
