# managed by dermaga; unit=traefik.container
[Unit]
Description=dermaga Traefik reverse proxy (socket-activated)
Requires=traefik-http.socket traefik-https.socket
After=traefik-http.socket traefik-https.socket

[Container]
ContainerName=traefik
Image=docker.io/library/traefik:v3.7.19@sha256:aa942a00bce033c909bf1f7e861d93761be4b31a035f10d2410d33e38a8f41cf
Network=web.network
Notify=true
NoNewPrivileges=true
ReadOnly=true
DropCapability=ALL
PidsLimit=256
PodmanArgs=--memory=256m
Volume=/home/server/.local/share/dermaga/traefik:/etc/traefik
Volume=/home/server/.local/share/dermaga/traefik/dynamic:/etc/traefik/dynamic:ro

[Quadlet]
DefaultDependencies=false

[Service]
Sockets=traefik-http.socket traefik-https.socket
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
