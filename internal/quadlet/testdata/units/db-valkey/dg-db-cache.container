# Generated by dermaga. Don't edit: change the app with dermaga instead.
[Quadlet]
DefaultDependencies=false

[Unit]
Description=dermaga database cache (valkey)

[Container]
ContainerName=dg-db-cache
Image=docker.io/valkey/valkey:9
Pull=never
Network=dg-db-cache.network
EnvironmentFile=/home/server/.config/dermaga/env/db-cache.env
Label=dermaga.database=cache
Label=dermaga.engine=valkey
NoNewPrivileges=true
DropCapability=ALL
AddCapability=SETGID SETUID KILL
Exec=/bin/sh -c 'exec valkey-server --requirepass "$$VALKEY_PASSWORD"'
PidsLimit=512
PodmanArgs=--memory=512m --cpus=1
StopTimeout=25
Volume=dg-db_cache.volume:/data

[Service]
Restart=always
TimeoutStartSec=120
TimeoutStopSec=45

[Install]
WantedBy=default.target
