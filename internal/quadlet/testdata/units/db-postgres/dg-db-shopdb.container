# Generated by dermaga. Don't edit: change the app with dermaga instead.
[Quadlet]
DefaultDependencies=false

[Unit]
Description=dermaga database shopdb (postgres)

[Container]
ContainerName=dg-db-shopdb
Image=docker.io/library/postgres:18
Pull=never
Network=dg-db-shopdb.network
EnvironmentFile=/home/server/.config/dermaga/env/db-shopdb.env
Label=dermaga.database=shopdb
Label=dermaga.engine=postgres
NoNewPrivileges=true
DropCapability=ALL
AddCapability=CHOWN DAC_OVERRIDE FOWNER SETGID SETUID KILL
PidsLimit=512
PodmanArgs=--memory=512m --cpus=1
StopTimeout=25
Volume=dg-db_shopdb.volume:/var/lib/postgresql

[Service]
Restart=always
TimeoutStartSec=120
TimeoutStopSec=45

[Install]
WantedBy=default.target
