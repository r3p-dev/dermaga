# managed by dermaga; app=demo
[Unit]
Description=dermaga app demo release 1

[Container]
ContainerName=app-demo-r1
Image=localhost/app-demo:r1
Network=web
PidsLimit=128
NoNewPrivileges=true
DropCapability=ALL
StopTimeout=10

[Quadlet]
DefaultDependencies=false

[Service]
Restart=on-failure
RestartSec=1s
RestartSteps=3
RestartMaxDelaySec=8s
TimeoutStartSec=30
TimeoutStopSec=20

[Install]
WantedBy=default.target
