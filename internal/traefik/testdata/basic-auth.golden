# managed by dermaga; app=internal-portal
{
  "http": {
    "routers": {
      "app-internal-portal": {
        "entryPoints": [
          "websecure"
        ],
        "rule": "Host(`portal.example.com`)",
        "service": "app-internal-portal",
        "middlewares": [
          "app-internal-portal-headers",
          "app-internal-portal-auth"
        ],
        "tls": {
          "certResolver": "le"
        }
      }
    },
    "services": {
      "app-internal-portal": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://app-internal-portal-r1:8080"
            }
          ]
        }
      }
    },
    "middlewares": {
      "app-internal-portal-auth": {
        "basicAuth": {
          "users": [
            "admin:$2a$10$mip4oyvC1HpMevKOZl8OL.HH2EV2Brq6pga/CUOIUZ62TMxii4ZEm",
            "operator:$2a$10$mip4oyvC1HpMevKOZl8OL.HH2EV2Brq6pga/CUOIUZ62TMxii4ZEm"
          ]
        }
      },
      "app-internal-portal-headers": {
        "headers": {
          "stsSeconds": 31536000,
          "stsIncludeSubdomains": true,
          "contentTypeNosniff": true,
          "customFrameOptionsValue": "SAMEORIGIN",
          "referrerPolicy": "strict-origin-when-cross-origin",
          "customResponseHeaders": {
            "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
            "Server": "",
            "X-Powered-By": ""
          }
        }
      }
    }
  }
}
