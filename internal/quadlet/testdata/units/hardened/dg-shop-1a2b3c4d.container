# Generated by dermaga. Don't edit: change the app with dermaga instead.
[Quadlet]
DefaultDependencies=false

[Unit]
Description=dermaga app shop, release 1a2b3c4d

[Container]
ContainerName=dg-shop-1a2b3c4d
Image=localhost/dermaga/shop:0123456789ab
Pull=never
Network=web.network
EnvironmentFile=/home/server/.config/dermaga/env/shop.env
Label=dermaga.app=shop
Label=dermaga.release=1a2b3c4d
NoNewPrivileges=true
DropCapability=ALL
AddCapability=CHOWN SETUID SETGID
ReadOnly=true
PidsLimit=128
