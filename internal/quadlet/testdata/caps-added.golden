# managed by dermaga; app=proxy
[Unit]
Description=dermaga app proxy release 1

[Container]
ContainerName=app-proxy-r1
Image=localhost/proxy:r1
Network=web
RunInit=true
PidsLimit=128
NoNewPrivileges=true
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
StopTimeout=10

[Quadlet]
DefaultDependencies=false

[Service]
Restart=on-failure
RestartSec=1s
RestartSteps=3
RestartMaxDelaySec=8s
TimeoutStartSec=30
TimeoutStopSec=20

[Install]
WantedBy=default.target
