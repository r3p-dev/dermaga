		"@tailwindcss/vite": "4.3.5",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "5.9.3",
		"vite": "8.3.6"
	}
}
